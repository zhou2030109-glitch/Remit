# ==============================================================================
# Remit 后端配置文件示例
# 复制此文件为 .env.dev 并填写实际配置
# 参考文档：../docs/configuration.md
# 配置项格式：KEY=VALUE（等号两侧无空格）
# 修改后需重启后端服务生效
# ==============================================================================

# ============ 环境设置 ============
# 当前运行环境：dev（开发）/ prod（生产）
# 决定加载对应的配置文件
ENV=dev

# ============ OpenAI Responses 全局配置 ============
# 项目当前没有独立 Reviewer Agent；REVIEW_MODEL 预留给审查流程扩展。
REVIEW_MODEL=
MODEL_REASONING_EFFORT=
DISABLE_RESPONSE_STORAGE=true
API_TIMEOUT_SECONDS=180
# 不可被旧配置绕过的单请求硬上限
API_HARD_TIMEOUT_SECONDS=180

# ============ 各 Agent API 配置 ============
# 系统包含4个核心Agent，每个独立配置：
# - Coordinator：协调器，负责任务调度和决策
# - Modeler：建模手，负责数学建模和算法设计
# - Coder：代码手，负责代码编写和执行
# - Writer：论文手，负责报告撰写和文档生成

# ------------------------------
# 协调器 Agent 配置
# ------------------------------
# API类型：openai-chat / openai-responses / anthropic
COORDINATOR_API_TYPE=openai-chat
# API密钥（请填写你的密钥）
COORDINATOR_API_KEY=
# 模型名称（如：deepseek-chat, gpt-4o-mini）
COORDINATOR_MODEL=
# API服务地址（如：https://api.deepseek.com/v1）
COORDINATOR_BASE_URL=
# 最大输出token数（控制响应长度）
COORDINATOR_MAX_TOKENS=32768
# 推理强度（供应商支持时生效；题目理解建议 high）
COORDINATOR_REASONING_EFFORT=high

# ------------------------------
# 建模 Agent 配置
# ------------------------------
# API类型
MODELER_API_TYPE=openai-chat
# API密钥
MODELER_API_KEY=
# 模型名称
MODELER_MODEL=
# API服务地址
MODELER_BASE_URL=
# 最大输出token数
MODELER_MAX_TOKENS=32768

# ------------------------------
# 编码 Agent 配置
# ------------------------------
# API类型
CODER_API_TYPE=openai-chat
# API密钥
CODER_API_KEY=
# 模型名称
CODER_MODEL=
# API服务地址
CODER_BASE_URL=
# 最大输出token数
CODER_MAX_TOKENS=32768

# ------------------------------
# 写作 Agent 配置
# ------------------------------
# API类型
WRITER_API_TYPE=openai-chat
# API密钥
WRITER_API_KEY=
# 模型名称
WRITER_MODEL=
# API服务地址
WRITER_BASE_URL=
# 最大输出token数
WRITER_MAX_TOKENS=32768

# ============ 可选服务配置 ============
# 以下服务为可选功能，不配置不影响核心建模流程

# ------------------------------
# E2B 代码执行环境（可选）
# 提供安全的Python代码沙箱执行环境
# 不配置则使用本地解释器执行代码
# ------------------------------
# E2B平台API密钥（需注册获取）
E2B_API_KEY=

# ------------------------------
# 本机计算后端
# 默认优先使用 MATLAB；只有未安装、许可证不可用或启动失败时才回退 Python。
# MATLAB_EXECUTABLE 留空时自动从 PATH 和常见安装目录查找。
# ------------------------------
CODE_EXECUTION_BACKEND=matlab
MATLAB_EXECUTABLE=
MATLAB_STARTUP_TIMEOUT_SECONDS=90
MATLAB_EXECUTION_TIMEOUT_SECONDS=300
MATLAB_FALLBACK_TO_PYTHON=true
PYTHON_EXECUTION_TIMEOUT_SECONDS=300
CODE_EXECUTION_HARD_LIMIT_SECONDS=300
CODE_EXECUTION_HEARTBEAT_SECONDS=15
CODE_EXECUTION_CANCEL_GRACE_SECONDS=10
CODE_COMPLEXITY_GUARD_ENABLED=true
CODE_LITERAL_LOOP_ITERATION_LIMIT=2000000
LATEX_ENGINE=xelatex
LATEX_COMPILE_TIMEOUT_SECONDS=120
PAPER_MIN_PDF_PAGES=8

# ------------------------------
# Tavily Web Search（可选）
# 使Agent能够联网搜索真实数据
# 配置 API 密钥后由调用该服务的功能按需使用
# ------------------------------
# Tavily搜索API密钥（需注册获取）
TAVILY_API_KEY=
# ------------------------------
# OpenAlex 学术搜索（可选）
# 用于检索学术论文引用信息
# 配置邮箱或API密钥即可使用
# ------------------------------
# OpenAlex邮箱（免费额度）
OPENALEX_EMAIL=
# OpenAlex API密钥（付费用户）
OPENALEX_API_KEY=

# ============ 系统配置 ============
# 基础系统运行参数

# 日志级别：DEBUG/INFO/WARN/ERROR
LOG_LEVEL=DEBUG
# 调试模式：true（开发）/ false（生产）
DEBUG=true
# 每个代码子任务的硬预算
MAX_CHAT_TURNS=20
MAX_CODE_EXECUTIONS_PER_RUN=12
# 同一阶段跨自动返修/重启累计；预占后中断也计入，不推测旧版历史次数。
MAX_CODE_EXECUTIONS_PER_STAGE=48

# API调用失败重试次数
MAX_RETRIES=3
GATEWAY_MAX_RETRIES=4
LLM_HARD_RETRY_LIMIT=4
# 每个检查点阶段累计模型尝试数与已观测 API 等待秒数；恢复不重置。
# pilot 有完整且匹配的小问实验协议时，总额度按协议小问数计算，已用额度仍保留。
LLM_STAGE_CALL_LIMIT=60
LLM_STAGE_API_SECONDS=2400
LLM_RETRY_AFTER_MAX_SECONDS=60
TASK_TIMEOUT_SECONDS=7200
TASK_AUTO_RESUME_LIMIT=1
TASK_AUTO_RESUME_BASE_DELAY_SECONDS=30

# ------------------------------
# Redis 配置
# 用于消息队列和状态管理
# ------------------------------
# Redis连接地址（本地开发）
REDIS_URL=redis://localhost:16379/0
# Docker Compose环境使用此地址
# REDIS_URL=redis://redis:6379/0

# 附件限制：单文件 128 MiB，整批 512 MiB，最多 100 个
UPLOAD_MAX_FILE_BYTES=134217728
UPLOAD_MAX_TOTAL_BYTES=536870912
UPLOAD_MAX_FILES=100

# ------------------------------
# CORS 跨域配置
# 允许前端访问后端的域名列表
# ------------------------------
CORS_ALLOW_ORIGINS=http://localhost:15173,http://127.0.0.1:15173

# ------------------------------
# 服务地址配置
# ------------------------------
# 后端服务访问地址
SERVER_HOST=http://localhost:18000

# ============ Remit 三级建模方法检索 ============
# 默认使用项目内置方法库，为每个正式小问返回 Top-K。
METHOD_RETRIEVAL_ENABLED=true
METHOD_RETRIEVAL_TOP_K=6
# 留空使用 backend/app/core/knowledge/modeling_methods.json；也可填写自定义 JSON 绝对路径。
METHOD_LIBRARY_PATH=

# ============ HIL 人机协作配置 ============
# Human-in-the-Loop，启用后人机协作审批功能
# 是否启用人机协作（true/false）
HIL_ENABLED=true
# 审批等待时间配置（当前审批不会因超时自动放行）
HIL_TIMEOUT=300
# ==============================================================================
# 配置示例参考：
#
# 【DeepSeek 配置示例】
#   COORDINATOR_API_TYPE=openai-chat
#   COORDINATOR_API_KEY=sk-xxx
#   COORDINATOR_MODEL=deepseek-chat
#   COORDINATOR_BASE_URL=https://api.deepseek.com/v1
#
# 【OpenAI 配置示例】
#   COORDINATOR_API_TYPE=openai-chat
#   COORDINATOR_API_KEY=sk-xxx
#   COORDINATOR_MODEL=gpt-4o-mini
#   COORDINATOR_BASE_URL=https://api.openai.com/v1
#
# 【Anthropic 配置示例】
#   COORDINATOR_API_TYPE=anthropic
#   COORDINATOR_API_KEY=sk-ant-api03-xxx
#   COORDINATOR_MODEL=claude-3-opus-20240229
#   COORDINATOR_BASE_URL=https://api.anthropic.com/v1
#
# 使用步骤：
# 1. 复制此文件为 .env.dev
# 2. 填写各 Agent 的 API Key 和模型信息
# 3. 根据需要配置可选服务
# 4. 启动 Redis 服务
# 5. 启动后端服务
# ==============================================================================
